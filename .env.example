# Non-secret image/deployment settings. Copy to .env; never commit the copy.
# Build and push the pinned AX task runner first (docs/K3S.md).
IMAGE_REPOSITORY=registry.example.com/your-project
AX_RUNNER_IMAGE=registry.example.com/your-project/ax-task-runner@sha256:REPLACE_ME
# Required for public access. Local-only port-forward is a separate opt-in.
PUBLIC_ORIGIN=https://agent-desk.example.com
CODEX_MODEL=gpt-6.1-sol
